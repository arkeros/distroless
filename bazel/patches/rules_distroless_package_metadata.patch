 load(":starlark_codegen_utils.bzl", "starlark_codegen_utils")
 load(":util.bzl", "util")
 
+# Encodes the subset of Debian version characters that must be percent-encoded
+# inside a purl (https://github.com/package-url/purl-spec). Debian versions
+# routinely contain `+` (e.g. `2.41-12+deb13u2`) and `:` (epoch separator,
+# e.g. `1:1.0-1`); `~` is allowed unescaped.
+def _purl_encode_version(version):
+    return version.replace("+", "%2B").replace(":", "%3A")
+
+def _deb_purl(name, version, arch, distro, source):
+    # Namespace is hardcoded to "debian" — covers Debian-derived apt repos
+    # (incl. rules_distroless's bullseye/bookworm/trixie and downstream debian-style repos).
+    purl = "pkg:deb/debian/{name}@{version}?arch={arch}".format(
+        name = name,
+        version = _purl_encode_version(version),
+        arch = arch,
+    )
+    if distro:
+        purl += "&distro={distro}".format(distro = distro)
+
+    # `upstream=<source>` lets advisory matchers (e.g. grype) bridge from
+    # binary package to source package — Debian indexes CVEs by source name
+    # (`glibc`), not binary (`libc6`). Without it, advisory lookup misses.
+    if source and source != name:
+        purl += "&upstream={source}".format(source = source)
+    return purl
+
+def upstream_version(version):
+    """The upstream version inside a Debian package version.
+
+    Epoch and Debian revision stripped, so `1:1.30.4-1~trixie` reads
+    `1.30.4`: the version upstream advisories and NVD ranges are expressed
+    in. Only the last dash-separated part is a revision; a dash inside the
+    upstream version survives.
+
+    Args:
+      version: a Debian package version, `[epoch:]upstream[-revision]`.
+
+    Returns:
+      The upstream part.
+    """
+    if ":" in version:
+        version = version.partition(":")[2]
+    if "-" in version:
+        version = version.rpartition("-")[0]
+    return version
+
+def upstream_identity(name, version, arch, cpe_vendor_product):
+    """purl and CPE for a package identified by its upstream, not the distro.
+
+    See `upstream_identities` on the install tag. The purl keeps `arch`, the
+    one qualifier that still describes the artifact; the distro qualifier
+    would route scanners back to the distro's tracker.
+
+    Args:
+      name: the package name.
+      version: the Debian package version; see upstream_version.
+      arch: the package architecture, e.g. "amd64".
+      cpe_vendor_product: the CPE vendor and product, e.g. "f5:nginx".
+
+    Returns:
+      (purl, cpe): `pkg:generic/<name>@<upstream version>?arch=<arch>` and
+      `cpe:2.3:a:<vendor>:<product>:<upstream version>:*:*:*:*:*:*:*`.
+    """
+    upstream = upstream_version(version)
+    purl = "pkg:generic/{name}@{version}?arch={arch}".format(
+        name = name,
+        version = _purl_encode_version(upstream),
+        arch = arch,
+    )
+    cpe = "cpe:2.3:a:{vp}:{version}:*:*:*:*:*:*:*".format(
+        vp = cpe_vendor_product,
+        version = upstream,
+    )
+    return purl, cpe
+
