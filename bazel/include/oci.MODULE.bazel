apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")

# `mergedusr = True` rewrites /bin, /sbin, /lib* under /usr to match Debian's
# UsrMerge layout (the only one supported on bookworm+). Without it, packages
# that ship the same path under both /bin and /usr/bin produce duplicate-path
# errors when assembling OCI layers. https://wiki.debian.org/UsrMerge
#
# `package_template` overrides the upstream rules_distroless per-.deb BUILD
# template with our own (loads `dpkg_statusd` + `package_metadata`).
apt.install(
    name = "debian",
    distro = "debian-unstable",
    lock = "//oci/distroless:debian.lock.json",
    manifest = "//oci/distroless:debian.yaml",
    mergedusr = True,
    package_template = "//oci/distroless/common:package.BUILD.tmpl",
)
apt.install(
    name = "nginx_stable",
    distro = "debian-unstable",
    lock = "//oci/distroless/nginx:nginx-stable.lock.json",
    manifest = "//oci/distroless/nginx:nginx-stable.yaml",
    mergedusr = True,
    package_template = "//oci/distroless/common:package.BUILD.tmpl",
)
apt.install(
    name = "nginx_mainline",
    distro = "debian-unstable",
    lock = "//oci/distroless/nginx:nginx-mainline.lock.json",
    manifest = "//oci/distroless/nginx:nginx-mainline.yaml",
    mergedusr = True,
    package_template = "//oci/distroless/common:package.BUILD.tmpl",
)
use_repo(apt, "debian", "nginx_mainline", "nginx_stable")

# Hummingbird RPM repository — sourced from a public Hummingbird snapshot
# (see ADR 0007). The lockfile pins `revision` + per-rpm SHA256; refresh
# via `bazel run @hummingbird//:pin` once the pin tool is wired (currently
# hand-written for the tracer-bullet tzdata-only state).
rpm = use_extension("@rules_rpm//rpm:extensions.bzl", "rpm")
rpm.install(
    name = "hummingbird",
    architectures = [
        "x86_64",
        "aarch64",
    ],
    # Matches grype's `hummingbird:distro:hummingbird:1` provider — drives
    # per-package secdb routing on SBOM scans. Without this qualifier, grype
    # falls back to NVD-CPE matching and silently misses Hummingbird's
    # backported advisories.
    distro = "hummingbird-1",
    gpg_key = "//:hummingbird-release.pgp",
    lock_file = "//:hummingbird.lock.json",
    # Closed manifest of *root* packages; pin walks rpm:requires and adds
    # transitively reachable packages to the lockfile (same posture as
    # @debian's apt resolver). Trim entries here only if you also want
    # their transitives gone — bare-bones cc needs glibc + libgcc +
    # libstdc++ + openssl-libs as roots; ca-certificates / mailcap /
    # tzdata stay declared because static composes them directly even
    # though glibc would otherwise pull ca-certificates transitively.
    packages = [
        "bash",
        "busybox",
        "ca-certificates",
        "coreutils",
        "glibc",
        "grep",
        "libacl",
        "libatomic",
        "libattr",
        "libcap",
        "libgcc",
        "libselinux",
        "libsepol",
        "libstdc++",
        "mailcap",
        "mawk",
        "ncurses-libs",
        "openssl-libs",
        "pcre2",
        "sed",
        "tzdata",
    ],
    # Per-arch subtrees (x86_64/, aarch64/) live under this base. Each
    # lockfile entry's `path` prefixes the right subtree (noarch entries
    # use either subtree — same bytes).
    repo_url = "https://koji-s3-cache.hummingbird-project.io/packages.redhat.com/api/pulp-content/public-hummingbird",
    # Hummingbird's RHPG snapshot publishes per-RPM GPG signatures and
    # sigstore attestations under `metadata/attestations/`, but no
    # detached signature over `repomd.xml` (verified empirically —
    # repodata listing contains only `repomd.xml`, `*-primary.xml.gz`,
    # `*-filelists.xml.gz`, `*-other.xml.gz`). Lock-time trust degrades
    # to TLS; build-time per-RPM verification in rpm-extract remains the
    # binary-integrity anchor. See ADR 0007's 2026-05-19 amendment.
    repomd_signature = "optional",
)

# nginx.org's own RPM repositories, mirroring how we already use their apt
# repos on the Debian side. Stable and mainline are first-class separate
# repos (no version-constraint pinning needed); each ships a single
# self-contained `nginx` rpm — no nginx/nginx-core/nginx-filesystem
# decomposition and none of Hummingbird's gperftools / libunwind /
# libxcrypt linkage. Lockfiles live alongside the consuming BUILD in
# //oci/distroless/nginx/ — same convention as the apt-side
# nginx-{stable,mainline}.lock.json. rhel/10 binaries match Hummingbird's
# glibc/openssl baseline at runtime.
rpm.install(
    name = "nginx_stable_rpm",
    architectures = [
        "x86_64",
        "aarch64",
    ],
    # Routes via Hummingbird's secdb even though the binary came from
    # nginx.org. RHEL-10's secdb has CVE entries for nginx but no fix
    # data (RHEL doesn't ship nginx) — every flag would be a no-fix
    # false positive. Hummingbird's secdb has accurate version-range
    # data and all current advisories are rpmvercmp-below the shipped
    # nginx.org rpm, so no flags surface today. Future advisories with
    # release-suffix-strict constraints (e.g. `< X-1.hum1`) may falsely
    # flag nginx.org's `*.el10.ngx` releases via rpmvercmp's suffix
    # ordering; document those in //oci/distroless/nginx/BUILD under
    # `NGINX_HUMMINGBIRD_*_VEX_STATEMENTS` when they arise.
    distro = "hummingbird-1",
    gpg_key = "//oci/distroless/nginx:nginx_signing.key",
    lock_file = "//oci/distroless/nginx:nginx-stable.hummingbird.lock.json",
    packages = ["nginx"],
    # Surfaces `pkg:rpm/nginx.org/nginx@...` in the image SBOM so grype
    # routes lookups to NVD-CPE rather than `pkg:rpm/nginx_stable_rpm/...`
    # (no provider matches). Crucially decouples nginx from the
    # `ID=hummingbird` image-scan routing, sidestepping false positives
    # from any Hummingbird advisory whose release-suffix-strict
    # `< X-1.hum1` constraint would match nginx.org's `el10.ngx` rpms
    # under rpmvercmp even when the upstream fix is in shared source.
    # With this namespace, grype's SBOM-scan correctly treats nginx as
    # an nginx.org-provided package and applies NVD's upstream
    # version-range matching.
    purl_namespace = "nginx.org",
    repo_url = "https://nginx.org/packages/rhel/10",
)
rpm.install(
    name = "nginx_mainline_rpm",
    architectures = [
        "x86_64",
        "aarch64",
    ],
    distro = "hummingbird-1",
    gpg_key = "//oci/distroless/nginx:nginx_signing.key",
    lock_file = "//oci/distroless/nginx:nginx-mainline.hummingbird.lock.json",
    packages = ["nginx"],
    purl_namespace = "nginx.org",
    repo_url = "https://nginx.org/packages/mainline/rhel/10",
)
use_repo(rpm, "hummingbird", "nginx_mainline_rpm", "nginx_stable_rpm")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Node.js runtime tarballs from nodejs.org. Consumed by //oci/distroless/nodejs
# (ADR 0007 step 6, the "marquee demo" distroless node on Hummingbird's glibc).
# Only `bin/node` is shipped in the image; npm/npx/corepack/headers/docs are
# left in the bazel-out tree and never make it into the layer.
#
# To refresh:
#   curl -fsSL https://nodejs.org/dist/index.json | jq '.[] | select(.version | startswith("v26."))[0]'
#   curl -fsSL https://nodejs.org/dist/v<version>/SHASUMS256.txt | grep linux
_NODEJS_TARBALL_BUILD_FILE_CONTENT = """\
package(default_visibility = ["//visibility:public"])
exports_files(["bin/node"])
"""

[
    http_archive(
        name = "nodejs_{}_{}".format(major, arch),
        build_file_content = _NODEJS_TARBALL_BUILD_FILE_CONTENT,
        sha256 = sha,
        strip_prefix = "node-v{}-linux-{}".format(
            full_version,
            "x64" if arch == "amd64" else "arm64",
        ),
        url = "https://nodejs.org/dist/v{}/node-v{}-linux-{}.tar.xz".format(
            full_version,
            full_version,
            "x64" if arch == "amd64" else "arm64",
        ),
    )
    for major, full_version, sha_by_arch in [
        (
            "24",
            "24.19.0",
            {
                "amd64": "14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647",
                "arm64": "01443c1e1a29e531ccad5a46fefa6df490d2189c49f7955904aecdbb0fe86fdc",
            },
        ),
        (
            "26",
            "26.6.0",
            {
                "amd64": "e53a8c8ca2ee7135de38e63859bd4f43002ae2d222f5b3a98ac1945db9f544bb",
                "arm64": "974e6f0332fb26179b34d49c57f35339e089a89faf8b82a81e44c0e1164b7923",
            },
        ),
    ]
    for arch, sha in sha_by_arch.items()
]

# Eclipse Temurin JRE tarballs from Adoptium GitHub releases. Consumed by
# //oci/distroless/java — the headless JRE ships under /jre/, mirroring
# nodejs's /nodejs/ prefix so the host distro's PATH never resolves to it.
# The image entrypoint is the absolute path /jre/bin/java.
#
# Policy: latest 3 LTS only, no non-LTS. Auto-rolls — when 29 ships in
# 2027, 17 rolls off and 29 lands here. Adoptium's LTS list is
# [8, 11, 17, 21, 25]; we explicitly do NOT ship 8/11 (EOL trajectory,
# tiny incremental users on new infra — same posture as Google Distroless).
#
# To refresh:
#   curl -fsSL https://api.adoptium.net/v3/info/available_releases
#   curl -fsSL "https://api.adoptium.net/v3/assets/latest/<V>/hotspot?architecture=x64&image_type=jre&os=linux&vendor=eclipse"
_TEMURIN_BUILD_FILE_CONTENT = """\
package(default_visibility = ["//visibility:public"])
filegroup(
    name = "all",
    srcs = glob(["**"], exclude = ["BUILD*", "REPO*", "WORKSPACE*", "MODULE*"], allow_empty = False),
)
"""

# JRE (release variant) and JDK (debug variant) per (major, arch). The JDK
# carries jstack/jcmd/jmap/javac for `kubectl exec`-style production
# diagnostics — Google Distroless's `:debug` variant uses the same trick.
# Versions are kept in lockstep across image_type because mixing build
# numbers would shift the CPE component the SBOM declares between modes.
[
    http_archive(
        name = "temurin_{}_{}_{}".format(image_type, major, arch),
        build_file_content = _TEMURIN_BUILD_FILE_CONTENT,
        sha256 = sha,
        strip_prefix = "jdk-{}+{}{}".format(
            version,
            build,
            "-jre" if image_type == "jre" else "",
        ),
        url = "https://github.com/adoptium/temurin{}-binaries/releases/download/jdk-{}%2B{}/OpenJDK{}U-{}_{}_linux_hotspot_{}_{}.tar.gz".format(
            major,
            version,
            build,
            major,
            image_type,
            "x64" if arch == "amd64" else "aarch64",
            version,
            build,
        ),
    )
    for image_type, sha_by_major in [
        (
            "jre",
            {
                "17": (
                    "17.0.19",
                    "10",
                    {
                        "amd64": "adb5a2364baa51de1ef91bb9911f5a61d24b045fe1d6647cb8050272a3a8ee75",
                        "arm64": "aae834297a87736869745be7c1fca3207ea9167c5824f41c88b0ebb2e3ccb9b1",
                    },
                ),
                "21": (
                    "21.0.11",
                    "10",
                    {
                        "amd64": "e5038aae3ca9ff670bc696496b0728dbd23d280026bad30291cb919221ecfdcb",
                        "arm64": "fa23d9d9945053e67bcc7638410eabf1e17a7672c7c95a24f70cd08b8407d36e",
                    },
                ),
                "25": (
                    "25.0.3",
                    "9",
                    {
                        "amd64": "487ad434d8b121ae3902d5ad9cb830cd8e1f75fefad6e2ba80f89d60e3db95d7",
                        "arm64": "d12d5b19ff7f6c4a99fd4f9eecede2c96e64df7d1f41cc84f2e9c9b38408600b",
                    },
                ),
            },
        ),
        (
            "jdk",
            {
                "17": (
                    "17.0.19",
                    "10",
                    {
                        "amd64": "d8afc263758141a66e0e3aafc321e783f7016696f4eaea067d340a269037d331",
                        "arm64": "83a52172678ec8975164648654869cb2e71d7c748b47aca94b29bbfa10c18e81",
                    },
                ),
                "21": (
                    "21.0.11",
                    "10",
                    {
                        "amd64": "4b2220e232a97997b436ca6ab15cbf70171ecff52958a46159dfa5a8c44ca4de",
                        "arm64": "8d498ec88e1c1989fab95c6784240ab92d011e29c54d20a3f9c324b13476f9ad",
                    },
                ),
                "25": (
                    "25.0.3",
