apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")

# `mergedusr = True` rewrites /bin, /sbin, /lib* under /usr to match Debian's
# UsrMerge layout (the only one supported on bookworm+). Without it, packages
# that ship the same path under both /bin and /usr/bin produce duplicate-path
# errors when assembling OCI layers. https://wiki.debian.org/UsrMerge
#
# `package_template` overrides the upstream rules_distroless per-.deb BUILD
# template with our own (loads `dpkg_statusd` + `package_metadata`).
apt.install(
    name = "debian",
    distro = "debian-unstable",
    lock = "//images:debian.lock.json",
    manifest = "//images:debian.yaml",
    mergedusr = True,
    package_template = "//images/common:package.BUILD.tmpl",
)

# nginx comes from nginx.org's own apt repo (its Debian dependencies from the
# same snapshot as @debian), and is identified by upstream rather than as a
# Debian package: `pkg:generic/nginx@<upstream version>` with an f5:nginx
# CPE, the shape Chainguard's apko SBOMs give the same package.
#
# A deb purl routes grype to Debian's tracker, whose advisories name Debian's
# own rebuild as the fix: Debian fixed CVE-2026-42533 in 1.30.4-3, so
# nginx.org's 1.30.4-1~trixie — which carries the upstream fix — sorts below
# it and is flagged. The CPE matches NVD's upstream ranges instead (on the
# pinned database, all three of nginx's July 2026 CVEs at 1.30.3 and none at
# 1.30.4; //images/nginx:nginx_cpe_canary_test keeps that true).
# `pkg:github/nginx/nginx@release-<v>` was considered and rejected: grype
# has no matcher for it and OSV no ecosystem, so it is a silent zero.
#
# The image says the same. It carries no dpkg status entry and no rpmdb row
# for nginx — either would make a scanner reading the image call it a distro
# package at the distro's version — so syft falls back to its nginx binary
# classifier, which reads the version out of /usr/sbin/nginx and emits the
# same generic purl and CPE. The publication gate scans the image that way
# too (`image_scans` in //oci:supply_chain.bzl), and
# //images/nginx:nginx_*_image_identity_test holds the two views equal. The
# price: a scanner with no nginx binary classifier (trivy) sees no nginx on
# the image at all, and must read the attested SBOM.
NGINX_UPSTREAM_IDENTITIES = {"nginx": "f5:nginx"}

apt.install(
    name = "nginx_stable",
    distro = "debian-unstable",
    lock = "//images/nginx:nginx-stable.lock.json",
    manifest = "//images/nginx:nginx-stable.yaml",
    mergedusr = True,
    package_template = "//images/common:package.BUILD.tmpl",
    upstream_identities = NGINX_UPSTREAM_IDENTITIES,
)
apt.install(
    name = "nginx_mainline",
    distro = "debian-unstable",
    lock = "//images/nginx:nginx-mainline.lock.json",
    manifest = "//images/nginx:nginx-mainline.yaml",
    mergedusr = True,
    package_template = "//images/common:package.BUILD.tmpl",
    upstream_identities = NGINX_UPSTREAM_IDENTITIES,
)
use_repo(apt, "debian", "nginx_mainline", "nginx_stable")

# Hummingbird RPM repository — sourced from a public Hummingbird snapshot
# (see ADR 0007). The lockfile pins `revision` + per-rpm SHA256; refresh
# via `bazel run @hummingbird//:pin` once the pin tool is wired (currently
# hand-written for the tracer-bullet tzdata-only state).
rpm = use_extension("@rules_rpm//rpm:extensions.bzl", "rpm")
rpm.install(
    name = "hummingbird",
    architectures = [
        "x86_64",
        "aarch64",
    ],
    # Matches grype's `hummingbird:distro:hummingbird:1` provider — drives
    # per-package secdb routing on SBOM scans. Without this qualifier, grype
    # falls back to NVD-CPE matching and silently misses Hummingbird's
    # backported advisories.
    distro = "hummingbird-1",
    gpg_key = "//images:hummingbird-release.pgp",
    lock_file = "//images:hummingbird.lock.json",
    # Closed manifest of *root* packages; pin walks rpm:requires and adds
    # transitively reachable packages to the lockfile (same posture as
    # @debian's apt resolver). Trim entries here only if you also want
    # their transitives gone — bare-bones cc needs glibc + libgcc +
    # libstdc++ + openssl-libs as roots; ca-certificates / mailcap /
    # tzdata stay declared because static composes them directly even
    # though glibc would otherwise pull ca-certificates transitively.
    packages = [
        "bash",
        "busybox",
        "bzip2-libs",
        "ca-certificates",
        "coreutils",
        "expat",
        "gdbm-libs",
        "glibc",
        "gmp",
        "grep",
        "libacl",
        "libatomic",
        "libattr",
        "libb2",
        "libcap",
        "libffi",
        "libgcc",
        "libgomp",
        "libselinux",
        "libsepol",
        "libstdc++",
        "libuuid",
        "libxcrypt",
        "libzstd",
        "mailcap",
        "mawk",
        "mpdecimal",
        "ncurses-libs",
        "openssl-libs",
        "pcre2",
        "python3",
        "python3.11",
        "python3.11-libs",
        "python3.12",
        "python3.12-libs",
        "python3.13",
        "python3.13-libs",
        "python3-libs",
        "readline",
        "sed",
        "sqlite-libs",
        "systemd-libs",
        "tzdata",
        "xz-libs",
    ],
    # Per-arch subtrees (x86_64/, aarch64/) live under this base. Each
    # lockfile entry's `path` prefixes the right subtree (noarch entries
    # use either subtree — same bytes).
    repo_url = "https://koji-s3-cache.hummingbird-project.io/packages.redhat.com/api/pulp-content/public-hummingbird",
    # Hummingbird's RHPG snapshot publishes per-RPM GPG signatures and
    # sigstore attestations under `metadata/attestations/`, but no
    # detached signature over `repomd.xml` (verified empirically —
    # repodata listing contains only `repomd.xml`, `*-primary.xml.gz`,
    # `*-filelists.xml.gz`, `*-other.xml.gz`). Lock-time trust degrades
    # to TLS; build-time per-RPM verification in rpm-extract remains the
    # binary-integrity anchor. See ADR 0007's 2026-05-19 amendment.
    repomd_signature = "optional",
)

# nginx.org's own RPM repositories, mirroring how we already use their apt
# repos on the Debian side. Stable and mainline are first-class separate
# repos (no version-constraint pinning needed); each ships a single
# self-contained `nginx` rpm — no images/nginx/nginx-core/nginx-filesystem
# decomposition and none of Hummingbird's gperftools / libunwind /
# libxcrypt linkage. Lockfiles live alongside the consuming BUILD in
# //images/nginx/ — same convention as the apt-side
# nginx-{stable,mainline}.lock.json. rhel/10 binaries match Hummingbird's
# glibc/openssl baseline at runtime.
rpm.install(
    name = "nginx_stable_rpm",
    architectures = [
        "x86_64",
        "aarch64",
    ],
    # Where the rpm is installed. nginx itself is not routed by it: see
    # upstream_identities.
    distro = "hummingbird-1",
    gpg_key = "//images/nginx:nginx_signing.key",
    lock_file = "//images/nginx:nginx-stable.hummingbird.lock.json",
    packages = ["nginx"],
    # Names the source for anything this repo ships that is not in
    # upstream_identities: `pkg:rpm/nginx.org/...` rather than
    # `pkg:rpm/nginx_stable_rpm/...`.
    purl_namespace = "nginx.org",
    repo_url = "https://nginx.org/packages/rhel/10",
    # Same identity as the apt side above. Hummingbird's secdb names its
    # own nginx rebuild as the fix, and rpmvercmp ranks nginx.org's
    # `1.el10.ngx` release tag below Hummingbird's `2.hum1`, which flagged
    # CVE-2026-60005 and CVE-2026-42533 on a build that carried both fixes.
    upstream_identities = NGINX_UPSTREAM_IDENTITIES,
)
rpm.install(
    name = "nginx_mainline_rpm",
    architectures = [
        "x86_64",
        "aarch64",
    ],
    distro = "hummingbird-1",
    gpg_key = "//images/nginx:nginx_signing.key",
    lock_file = "//images/nginx:nginx-mainline.hummingbird.lock.json",
    packages = ["nginx"],
    purl_namespace = "nginx.org",
    repo_url = "https://nginx.org/packages/mainline/rhel/10",
    upstream_identities = NGINX_UPSTREAM_IDENTITIES,
)
use_repo(rpm, "hummingbird", "nginx_mainline_rpm", "nginx_stable_rpm")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

grype_db = use_extension("@grype.bzl//grype:extensions.bzl", "grype_database", dev_dependency = True)
grype_db.database(
    name = "grype_database",
    sha256 = "ce7ae6d4f7fb81029fc3bd1891b6b441f96bac4e278519743e4768eebd805e69",
    url = "https://grype.anchore.io/databases/v6/vulnerability-db_v6.1.9_2026-09-10T00:31:01Z_1789021824.tar.zst",
)
use_repo(grype_db, "grype_database")

# Sigstore's trusted root: the Fulcio CAs, Rekor logs and CT logs a mirror
# signature is checked against. //web verifies attestations against this before
# rendering them, so it ships inside that binary rather than being fetched at
# runtime — a page whose subject is supply-chain evidence should not depend on
# tuf-repo-cdn.sigstore.dev being up to render. CI's `publish` and `verify`
# jobs verify against the same file (via //oci:sigstore_trusted_root), so the
# root the mirror is checked with at publish time is the root the Directory
# renders with.
#
# The URL is the moving target on purpose. The TUF CDN also serves this file
# under a content-addressed name (`<sha256>.trusted_root.json`), which is
# tempting and wrong: a CAS URL can never fail its checksum, so it can never
# tell us the root has moved on. Pinning a stable URL means Bazel's integrity
# check *is* the drift detector — the day Sigstore publishes a new root this
# fetch fails with expected-vs-actual instead of silently serving a root that
# no longer covers current signatures.
#
# Trust comes from `sha256`, not from the host. When refreshing, take the hash
# from TUF's *signed* targets.json (below) rather than from the file GitHub
# serves, then confirm GitHub matches it. That keeps the chain rooted in TUF
# even though the bytes arrive over plain HTTPS.
#
# Unlike TUF metadata this target has no expiry field — its CAs and logs carry
# open-ended `validFor` windows. It changes only when Sigstore *adds* a log or
# CA (twice since 2021: Fulcio's 2022 root, Rekor's 2025 log).
#
# To refresh:
#   SNAP=$(curl -fsSL https://tuf-repo-cdn.sigstore.dev/timestamp.json \
#     | jq -r '.signed.meta["snapshot.json"].version')
#   TGT=$(curl -fsSL https://tuf-repo-cdn.sigstore.dev/$SNAP.snapshot.json \
#     | jq -r '.signed.meta["targets.json"].version')
#   curl -fsSL https://tuf-repo-cdn.sigstore.dev/$TGT.targets.json \
#     | jq -r '.signed.targets["trusted_root.json"].hashes.sha256'
http_file(
    name = "sigstore_trusted_root",
    downloaded_file_path = "trusted_root.json",
    sha256 = "6494e21ea73fa7ee769f85f57d5a3e6a08725eae1e38c755fc3517c9e6bc0b66",
    url = "https://raw.githubusercontent.com/sigstore/root-signing/main/targets/trusted_root.json",
)
