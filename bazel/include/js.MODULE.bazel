"""JavaScript configuration: the toolchain that builds the directory script,
and the Node.js runtime the node images ship.

The directory pages ship one script, and it is the only part of this repo a
browser executes rather than a toolchain we control. Nothing else here can
catch a mistake in it: a Go test renders the templates but never runs the
script, so a reference error or a sort that compares strings where it meant
numbers passes every other test and breaks only in a reader's browser.

No npm dependencies, and none intended — the script has none, so there is no
package lockfile to keep pinned. This is the node toolchain, and esbuild to
minify what the browser is sent: the sources carry their reasoning in
comments, and a reader's browser has no use for any of it.

The runtime is a separate thing: prebuilt linux tarballs from nodejs.org,
pinned in //images/nodejs:nodejs.lock.json and refreshed by
`knife tarballs update` (daily, via the Update Tarballs workflow). Adding or
dropping a release line is a hand edit of that lockfile.
"""

bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "aspect_rules_esbuild", version = "0.27.0")

esbuild = use_extension("@aspect_rules_esbuild//esbuild:extensions.bzl", "esbuild")
esbuild.toolchain(esbuild_version = "0.28.0")
use_repo(esbuild, "esbuild_toolchains")

register_toolchains("@esbuild_toolchains//:all")

tarballs = use_extension("//bazel/tarballs:extensions.bzl", "tarballs")

# Node.js from nodejs.org (ADR 0007 step 6, the "marquee demo" distroless
# node on Hummingbird's glibc). Only `bin/node` is shipped in the image;
# npm/npx/corepack/headers/docs are left in the bazel-out tree and never
# make it into the layer.
tarballs.lock(
    name = "nodejs_tarballs",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])
exports_files(["bin/node"])
""",
    lockfile = "//images/nodejs:nodejs.lock.json",
)
use_repo(tarballs, "nodejs_24_amd64", "nodejs_24_arm64", "nodejs_26_amd64", "nodejs_26_arm64", "nodejs_tarballs")
