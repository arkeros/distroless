"Terraform toolchain configuration"

# `terraform.bzl` (tf_root / provider hub / hermetic CLI toolchain) lives in
# the senku repo under `bazel/modules/terraform.bzl`. It is not published to
# BCR and `git_override` cannot address a subdirectory, so it is pinned via
# `archive_override` + `strip_prefix`.
bazel_dep(name = "terraform.bzl", version = "0.0.0")
archive_override(
    module_name = "terraform.bzl",
    strip_prefix = "senku-3381c487017eb556ffc078d5d5022c658ca7689e/bazel/modules/terraform.bzl",
    urls = ["https://github.com/arkeros/senku/archive/3381c487017eb556ffc078d5d5022c658ca7689e.tar.gz"],
)

# For local iteration against a sibling senku checkout:
# local_path_override(
#     module_name = "terraform.bzl",
#     path = "../senku/bazel/modules/terraform.bzl",
# )

terraform = use_extension("@terraform.bzl//terraform:extensions.bzl", "terraform")
terraform.toolchain(version = "1.14.8")
terraform.install(
    name = "terraform_providers",
    lock_file = "//:.terraform.lock.hcl",
)
use_repo(terraform, "terraform_providers", "terraform_toolchains")

register_toolchains("@terraform_toolchains//:terraform_toolchain")
