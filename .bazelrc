# sha256, Bazel's default, on purpose. BLAKE3 was used until 2026-09 for
# hashing speed, but the whole output tree is ~5 GB and hashes in seconds
# either way, while sha256 is what everything downstream of the build speaks:
# OCI blob digests, cosign, slsa-verifier, Rekor. Matching them lets a layer's
# key in the remote cache be its digest in the registry, which is what
# rules_img's lazy push and bazel-remote both require (neither supports
# BLAKE3). Changing the digest function changes every cache key, so this line
# is a cold cache the day it moves.

import %workspace%/bazel/defaults.bazelrc

# Support for seekable eStargz layers
# with the containerd stargz-snapshotter
common --@rules_img//img/settings:estargz=enabled
common --@rules_img//img/settings:compress=zstd

# Tar outputs go to the remote cache like everything else. tar.bzl's README
# suggests `--modify_execution_info=Tar=+no-remote-cache` to keep large,
# cheaply rebuilt tars out of the cache, and this file carried it until
# 2026-09. It is gone because lazy push (below) reads a missing layer out of
# the CAS and streams it through the pusher to the registry, and a layer a
# Tar action produced — the dpkg status.d layer in every image, the JDK and
# Node binaries — was never in the CAS, so the push failed on it. With
# build-without-the-bytes, a cached tar is downloaded only by an action that
# needs it as an input and runs on this machine; a quiet CI run downloads none.
#
# Every machine used to build every tar itself, so a tar whose bytes depend on
# the machine gave every CI job a different image digest. That happened: a
# hand-written mtree entry without `time=` made bsdtar record the checkout
# mtime, and the `release` job built an nginx digest `publish` had never
# pushed (run 33618108072). This validation action fails the build on any
# `type=file` mtree entry missing uid, gid, time or mode, naming the line.
# Wired here, not as a `--config=`, so it holds for local builds too.
common --@tar.bzl//tar:validate_reproducibility

build --sandbox_add_mount_pair=/tmp

build --workspace_status_command=bazel/workspace_status.sh

# Local Bazel registry for vendored upstream packages with security patches
# (busybox, libpq, …). BCR-shaped: source.json + overlay/ + patches/.
# Local first so it shadows BCR for module names we maintain in-tree; BCR
# listed explicitly because once any --registry is set, the implicit BCR
# default is dropped.
common --registry=file://%workspace%/bazel/registry
common --registry=https://bcr.bazel.build

# Build all Go binaries as PIE (position-independent executables). Required
# because the hermetic LLVM cc toolchain defaults to PIE-mode `ld.lld`,
# which rejects rules_go's default non-PIC relocations
# (`R_X86_64_64 cannot be used against symbol …; recompile with -fPIC`).
# `linkmode=pie` makes rules_go emit PIE-compatible objects up front; also
# keeps the ASLR hardening on the main binary that we'd lose with the
# alternative `--linkopt=-no-pie` workaround.
common --@rules_go//go/config:linkmode=pie

# We build no Android code, but rules_android's @androidsdk repo rule reads
# ANDROID_HOME and hard-fails when it points at a directory without SDK APIs
# (e.g. Renovate's containerbase image sets it to an empty ~/.android-sdk,
# which broke every `bazel run` postUpgradeTask). Pin it empty so the repo
# rule always takes its "empty repository that allows non-Android code to
# build" path, regardless of host environment.
common --repo_env=ANDROID_HOME=

# Enforce ADR 0006/0014 at analysis time: any `image_push` to the public mirror
# surface (`ghcr.io/arkeros/distroless/*`) without the `mirror_push_managed` tag
# fails the build. Wired here (not as a `--config=`) so the policy is
# unrepresentable in local dev too — there's no `bazel build` invocation
# that bypasses it. See `//oci:aspects.bzl`.
common --aspects=//oci:aspects.bzl%mirror_push_enforcement_aspect

# Linters, as aspects (//tools/lint:linters.bzl), over every target on the
# command line, for plain Bazel. A finding fails the build: without the
# Aspect CLI that is the only way it reaches the terminal, as the aspects
# otherwise write their reports under bazel-out and exit zero. `aspect lint`
# runs the same aspects (.aspect/config.axl) and prints the reports instead;
# CI runs that.
common:lint --aspects=//tools/lint:linters.bzl%buildifier,//tools/lint:linters.bzl%shellcheck,//tools/lint:linters.bzl%oxlint
common:lint --@aspect_rules_lint//lint:fail_on_violation

# Allow many actions in flight at once, rather than the default of one per
# CPU core. Local execution is bounded by --local_resources, so this does not
# oversubscribe the CPU; it only keeps Bazel's scheduler from serialising.
common:ci --jobs=200

# Skip tests that need real arm64 silicon. qemu-user can register linux/arm64
# binaries (binfmt) but its CPU-feature/syscall emulation is incomplete; in
# particular HotSpot silently bails during startup probes, so the
# java*_arm64_hummingbird_test commandTests fail with empty stdout on the
# amd64 GitHub runners. Drop this filter once CI runs on arm64 hardware.
test:ci --test_tag_filters=-requires-native-arm64

# Don't build protoc from the cc_binary, it's slow and spammy when cache miss
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
common --incompatible_python_disallow_native_rules

# Allow user-specific overrides for this repository
# in a git-ignored file.
# Should be at the end of this file so that users can override anything above.
try-import %workspace%/.bazelrc.user

# rules_esbuild and rules_lint carry Aspect's ruleset telemetry, which reports the module
# graph to Aspect from the machine evaluating it. Off, with the variable the
# module documents honouring, so neither CI nor a laptop reports anywhere.
common --repo_env=DO_NOT_TRACK=1
