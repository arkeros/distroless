# Ignore all bazel-* symlinks. There is no full list since this can change
# based on the name of the directory bazel is cloned into.
/bazel-*

# User-specific bazel configuration
.bazelrc.user

node_modules/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan

.DS_Store

# Workload identity credential config written into the workspace by
# google-github-actions/auth. Untracked files here are not harmless: the
# package-update workflows run `peter-evans/create-pull-request`, which
# stages everything with `git add -A` and would otherwise commit this file
# into the generated PR (it did, in #17).
gha-creds-*.json
